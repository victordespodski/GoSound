digraph ER { rankdir=TB; graph [bgcolor="white",pad="0.2"]; node [shape=box,style="rounded,filled",fillcolor="#eef2f5",fontname="DejaVu Sans",fontsize=12]; edge [fontname="DejaVu Sans",fontsize=10]; User [label="ApplicationUser\nId (PK)"]; Category [label="Category\nId (PK), Name (unique)"]; Podcast [label="Podcast\nId (PK), OwnerId (FK), CategoryId (FK)"]; Episode [label="Episode\nId (PK), PodcastId (FK)"]; Follow [label="Follow\nUserId + PodcastId (PK, FK)"]; Progress [label="ListeningProgress\nUserId + EpisodeId (PK, FK)"]; User->Podcast [label="1:N"]; Category->Podcast [label="1:N"]; Podcast->Episode [label="1:N"]; User->Follow [label="1:N"]; Podcast->Follow [label="1:N"]; User->Progress [label="1:N"]; Episode->Progress [label="1:N"]; }